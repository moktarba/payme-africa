# Application
NODE_ENV=development
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=payme
DB_PASSWORD=payme_secret
DB_NAME=payme_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change_this_in_production_super_secret_key_256bits
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# OTP / SMS (Africa's Talking)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=PayMe

# OTP Config
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

# Paiements
WAVE_API_KEY=
WAVE_MERCHANT_ID=
WAVE_WEBHOOK_SECRET=

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_WEBHOOK_SECRET=

# ─── PayDunya SoftPay ──────────────────────────────────────────────────────────
# Clés disponibles dans : PayDunya Dashboard → Intégrez notre API → Votre application
# Mode sandbox : clés préfixées test_  |  Mode production : clés préfixées live_
# Docs : https://developers.paydunya.com/doc/FR/softpay

PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# URL IPN déclarée dans PayDunya ET envoyée dans chaque invoice.
# Doit être publiquement accessible (pas localhost en dev → utiliser ngrok).
PAYDUNYA_CALLBACK_URL=https://api.faymafrica.fr/webhooks/paydunya

# Feature flags
FEATURE_WAVE_ENABLED=true
FEATURE_ORANGE_ENABLED=false
FEATURE_FREE_MONEY_ENABLED=false
FEATURE_PAYDUNYA_ENABLED=false

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,exp://localhost:19000

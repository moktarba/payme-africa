# Stage 1 : Build de l'app Expo Web
FROM node:20-alpine AS builder

WORKDIR /app

# Copier les dépendances
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copier le code source
COPY . .

# Variables d'environnement pour le build
ARG EXPO_PUBLIC_API_URL=https://api.faymafrica.fr
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL

# Builder l'app Expo pour le web
RUN npx expo export --platform web --output-dir dist

# Stage 2 : Servir les fichiers statiques avec nginx
FROM nginx:alpine

# Config nginx pour SPA (Single Page App)
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

# Copier le build Expo
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
